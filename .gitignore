# Backup files (keep local only)
index.backup.html
*.backup.*

# System files
.DS_Store
**/.DS_Store
Thumbs.db
*.log
__MACOSX/
**/__MACOSX/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp

# Node dependencies and generated build output
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/

# Environment variables (security)
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
firebase-config.js
**/firebase-config.js
!config/firebase-config.example.js

# Deployment config that may have sensitive info
# (keep netlify.toml and _headers as they are safe)

# Test outputs
test-results/
**/test-results/
coverage/
**/coverage/
playwright-report/
**/playwright-report/

# Local deployment caches
.wrangler/
**/.wrangler/

# Reference materials (copyright; keep local only)
# The MCM 11th edition PDF and reference CSVs are protected works.
# Bayesian engine consumes only the parsed JSON / generated mcm_data.js.
*.pdf
*.csv
assets/references/local/

# Intermediate MCM extraction artifacts (regenerable from PDF via scripts)
scripts/mcm_extract/layout/
scripts/mcm_extract/raw_tables/
scripts/mcm_extract/tables/
scripts/mcm_extract/*.txt
# Keep the parsed JSON committed for reproducibility:
!scripts/mcm_extract/parsed/*.json

# Local archive of deprecated files; active sources live in root, js/, scripts/, and v2/.
archive/
