# Backup files (keep local only)
index.backup.html
*.backup.*

# System files
.DS_Store
Thumbs.db
*.log

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp

# Node modules (if using npm later)
node_modules/

# Environment variables (security)
.env
.env.local

# Deployment config that may have sensitive info
# (keep netlify.toml and _headers as they are safe)

# Test outputs
test-results/
coverage/

# Reference materials (copyright; keep local only)
# The MCM 11th edition PDF and reference CSVs are protected works.
# Bayesian engine consumes only the parsed JSON / generated mcm_data.js.
*.pdf
*.csv

# Intermediate MCM extraction artifacts (regenerable from PDF via scripts)
scripts/mcm_extract/layout/
scripts/mcm_extract/raw_tables/
scripts/mcm_extract/tables/
scripts/mcm_extract/*.txt
# Keep the parsed JSON committed for reproducibility:
!scripts/mcm_extract/parsed/*.json

# Old data files (kept locally for reference; active data is in js/data.js)
data/bacteria_biochem_identification.json
data/bacteria_database_v2.json
data/biochemical_tests_detail.json
data/library_batch3.js

# Old test files (kept locally for reference; active tests in scripts/test_bayes.mjs)
tests/TEST_GUIDE.md
tests/TEST_REPORT.md
tests/console_test.js
tests/test-runner.js
tests/testsprite-runner.js
tests/testsprite.config.js

# Outdated deployment copies (root files are canonical)
/public/

# Root CSV exports (regenerable)
*.csv
